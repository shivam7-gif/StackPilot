{
  "meta": {
    "provider": "openrouter",
    "baseUrl": "https://openrouter.ai/api/v1",
    "endpoint": "/chat/completions",
    "verifiedOn": "2026-10-05",
    "note": "Free model availability changes often. Re-check https://openrouter.ai/models?max_price=0 and remove any ID that no longer works.",
